---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import YouTube from './YouTube.astro';
import VideoLoop from './VideoLoop.astro';
import portrait from '../assets/img/hero-race.jpg';
import trail from '../assets/img/trail-selfie.jpg';
import fpv from '../assets/img/fpv-powell.jpg';
import run from '../assets/img/run-50mi.jpg';
import desk from '../assets/img/desk.jpg';
import arc from '../assets/img/poster-arcboat.jpg';
import fairing from '../assets/img/seatpost-fairing.jpg';
import carbon from '../assets/img/carbon-bar.jpg';
import suit from '../assets/img/portrait-suit.jpg';
import rocket9 from '../assets/img/rocket-9th-grade.jpg';
import crew from '../assets/img/event-crew.jpg';

const hobbies = [
  { img: trail, alt: 'Selfie on a high mountain trail in a race kit', label: 'Racing bikes' },
  { img: fpv, alt: 'Holding an FPV drone with goggles on, Lake Powell behind', label: 'Flying FPV' },
  { img: run, alt: 'Headlamp selfie during a 54-mile ultramarathon, run through the night', label: 'Running a 54-mile ultramarathon' },
  { img: desk, alt: 'Desk with an edit open on the monitor, drone gear, and race bibs on the wall', label: 'Editing it all' },
];

const timeline = [
  { age: '13', text: 'Built my first 3D printer and taught myself Fusion 360. Designed a housing for it and printed small gliders. I loved watching something come from nothing.' },
  { age: '14', text: 'Spent summer mornings in the computer lab teaching myself HTML and CSS. Designed and printed my first rocket, a water rocket with its own parachute deployment system, launched it off the school field, and published it on Thingiverse, where it still lives.', link: { href: site.links.thingiverse, label: 'The rocket, on Thingiverse' }, video: site.youtube.waterRocket, videoTitle: 'Water rocket parachute deployment system, 9th grade', img: rocket9, alt: 'A 3D-printed rocket lifting off a launch stand on a school field, thumbs up from the launcher' },
  { age: '15', text: 'Made a LinkedIn profile, went to a business conference, and wrote a post about why I wanted to work at Enlisted, a studio building the first production electric boat designed from the ground up. Interviewed the next day and got the internship. Fixed their printers, ran to Home Depot, and filmed the engineers at work.', img: arc, alt: 'Frame from the Enlisted design documentary: a designer seated in a dark workshop' },
  { age: '16–17', text: 'Bought my first real camera. Became director of photography at Phuture Films and built a team around me that made five award-winning films in a short window, winning two national competitions. Shot weddings and brand work, and built cranes and rigs out of whatever was around.', img: crew, alt: 'Three cameramen at an event, smiling' },
  { age: '18', text: 'Designed and printed aero fairings to gain an edge on the race course. Founded North Media House and ran it through the summer. Two weeks before I left on my mission, I ran fifty miles through the night.', img: fairing, alt: '3D-printed textured fairing fitted to a bike seatpost' },
  { age: '18–20', text: 'Two years of full-time missionary service in the Philippines San Pablo Mission, in Tagalog. Long weeks, new places, and a lot of learning how to work with people.', img: suit, alt: 'Portrait in a dark suit and tie under green trees' },
  { age: 'Now', text: 'Home since August, and a first-year mechanical engineering student at BYU. I came back to rockets: designed my first two liquid engines, and am now building a liquid ethanol engine, laying up carbon fiber, and refining Manta, the handlebar I designed from a problem I hit while racing.', img: carbon, alt: 'Carbon fiber handlebar prototype on concrete' },
];
---
<section class="section" id="about">
  <div class="wrap">
    <div class="section-head">
      <h2 class="h-section">About me</h2>
      <p class="lede">Engineer by training, filmmaker by habit, and happiest when a thing I drew becomes a thing I can hold.</p>
    </div>

    <div class="intro">
      <div class="intro-photo">
        <Image src={portrait} alt="Matthew, mud-splattered and grinning at a mountain bike race finish" widths={[400, 800]} sizes="(min-width: 900px) 30vw, 60vw" format="webp" />
        <p class="cap">Finish line. Still smiling.</p>
      </div>
      <div class="intro-text prose">
        <p class="lede">Hi, I'm Matthew Foote, a mechanical engineering student at BYU. I love designing and building hardware, rocketry, and anything engineering. In my free time I race bikes, fly FPV drones, run long distances, and make videos documenting all of it.</p>
        <p class="quiet">I got home from two years in the Philippines in August and went straight back to the shop.</p>
        <p class="quiet">Here's a short film about why I ride. It was made properly, and it says it better than I can.</p>
      </div>
    </div>

    <div class="films">
      <div>
        <YouTube id={site.youtube.nica} title="My NICA Racing Journey" />
        <p class="cap">My NICA racing journey, in about three minutes.</p>
      </div>
      <div>
        <YouTube id={site.youtube.ride} title="Riding, shot on GoPro chest mount" />
        <p class="cap">And this is what free time looks like. GoPro on a chest mount, no crew.</p>
      </div>
    </div>

    <ul class="hobbies">
      {hobbies.map((h) => (
        <li>
          <div class="frame">
            <Image src={h.img} alt={h.alt} widths={[400, 800]} sizes="(min-width: 700px) 20vw, 50vw" format="webp" />
          </div>
          <p class="cap">{h.label}</p>
        </li>
      ))}
      <li class="hobby-video">
        <VideoLoop src="/media/video/skate-loop.mp4" label="Skateboarding down an empty road with the Tetons behind" aspect="4/5" />
        <p class="cap">Skating</p>
      </li>
    </ul>

    <h3 class="h-block tl-title">How I got here</h3>
    <ol class="timeline">
      {timeline.map((t) => (
        <li class="tl-item">
          <div class="tl-age display">{t.age}</div>
          <div class="tl-body">
            <p class="prose">{t.text}{t.link && <> <a href={t.link.href} rel="noopener">{t.link.label}</a></>}</p>
            {t.video ? (
              <div class="tl-video">
                <YouTube id={t.video} title={t.videoTitle} poster={t.img} />
              </div>
            ) : t.img && (
              <div class="frame tl-img">
                <Image src={t.img} alt={t.alt} widths={[500, 1000]} sizes="(min-width: 900px) 34vw, 100vw" format="webp" />
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .intro { display: grid; gap: 2rem; margin-bottom: 3rem; }
  @media (min-width: 900px) { .intro { grid-template-columns: 0.55fr 1fr; gap: 3.5rem; align-items: center; } }
  .intro-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border-radius: var(--radius); }
  .intro-text .lede { margin-bottom: 1.25rem; }

  .films { display: grid; gap: 1.5rem; margin-bottom: 3rem; }
  @media (min-width: 700px) { .films { grid-template-columns: 1fr 1fr; } }

  .hobbies { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: clamp(3rem, 7vw, 5rem); }
  @media (min-width: 700px) { .hobbies { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1000px) { .hobbies { grid-template-columns: repeat(5, 1fr); } }
  .hobbies .frame img { aspect-ratio: 4 / 5; }
  .hobby-video .loop { aspect-ratio: 4 / 5; }
  @media (max-width: 699px) { .hobby-video { grid-column: span 2; } .hobby-video .loop { aspect-ratio: 4 / 3 !important; } }

  .tl-title { margin-bottom: 2rem; }
  .timeline { display: grid; border-top: 1px solid var(--line); }
  .tl-item {
    display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem;
    padding: 1.75rem 0; border-bottom: 1px solid var(--line);
  }
  @media (min-width: 700px) { .tl-item { grid-template-columns: 9rem 1fr; gap: 2rem; } }
  .tl-age { font-size: clamp(1.6rem, 3.4vw, 2.6rem); white-space: nowrap; color: var(--tan-deep); line-height: 1; padding-top: 0.15em; }
  .tl-body { display: grid; gap: 1.25rem; }
  @media (min-width: 900px) { .tl-body { grid-template-columns: 1fr 0.8fr; align-items: start; gap: 2.5rem; } }
  .tl-img img { aspect-ratio: 4 / 3; }
  .tl-video { align-self: start; }
</style>
